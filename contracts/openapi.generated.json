  "components": {
    "schemas": {
      "ServerInfo": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "protocol": {
            "type": "string",
            "const": "v1"
          },
          "ready": {
            "type": "boolean",
            "const": true
          },
          "capabilities": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "provider": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "protocol",
          "ready",
          "capabilities",
          "provider"
        ],
        "additionalProperties": false
      },
      "CreateInput": {
        "type": "object",
        "properties": {
          "cwd": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "projectId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          }
        },
        "required": [
          "cwd"
        ],
        "additionalProperties": false
      },
      "CwdInput": {
        "type": "object",
        "properties": {
          "cwd": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        },
        "required": [
          "cwd"
        ],
        "additionalProperties": false
      },
      "Conversation": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "cwd": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "lastActivity": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "projectId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          }
        },
        "required": [
          "id",
          "cwd",
          "model"
        ],
        "additionalProperties": false
      },
      "SubmitInput": {
        "type": "object",
        "properties": {
          "requestId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "mode": {
            "type": "string",
            "enum": [
              "prompt",
              "followup",
              "steer"
            ]
          },
          "content": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32000
          }
        },
        "required": [
          "requestId",
          "mode",
          "content"
        ],
        "additionalProperties": false
      },
      "Receipt": {
        "type": "object",
        "properties": {
          "submissionId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          }
        },
        "required": [
          "submissionId"
        ],
        "additionalProperties": false
      },
      "AbortInput": {
        "type": "object",
        "properties": {
          "target": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          }
        },
        "required": [
          "target"
        ],
        "additionalProperties": false
      },
      "Problem": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "additionalProperties": false
      },
      "Entry": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "kind": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "toolName": {
            "type": "string"
          },
          "toolSucceeded": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "kind",
          "text"
        ],
        "additionalProperties": false
      },
      "HistoryPage": {
        "type": "object",
        "properties": {
          "entries": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Entry"
            }
          },
          "before": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          }
        },
        "required": [
          "entries"
        ],
        "additionalProperties": false
      },
      "ContextUsage": {
        "type": "object",
        "properties": {
          "tokens": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "window": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "tokens",
          "window"
        ],
        "additionalProperties": false
      },
      "ConversationView": {
        "type": "object",
        "properties": {
